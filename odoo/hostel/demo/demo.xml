            <field name="student_ids" eval="[Command.set([ref('student_hda'), ref('student_jvo'), ref('student_vb'), ref('student_jb')])]" />
            <!-- Tuple: <field name="hostel_amenities_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac')])]" /> -->
            <field name="hostel_amenities_ids" eval="[Command.set([ref('amenity_wifi'), ref('amenity_ac')])]" />
        </record>
        <record id="hostel_room_103" model="hostel.room">
            <field name="name">Hostel Room 103</field>
            <field name="room_number">HR103</field>
