<odoo>
    <data>
        <!-- Categories -->
        <record id="hostel_category_hotel" model="hostel.category">
            <field name="name">Hotel</field>
        </record>
        <record id="hostel_category_motel" model="hostel.category">
            <field name="name">Motel</field>
        </record>
        <record id="hostel_category_hostel" model="hostel.category">
            <field name="name">Hostel</field>
        </record>

        <!-- Famous Hostels/Hotels/Motels -->
        <!-- 1. The Plaza Hotel (USA) -->
        <record id="hostel_plaza_us" model="hostel.hostel">
            <field name="name">The Plaza Hotel</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">PLZ_NY</field>
            <field name="street">768 5th Ave</field>
            <field name="phone">+12127593000</field>
            <field name="mobile">+12127593001</field>
            <field name="type">common</field>
        </record>

        <!-- 2. The Savoy (UK) -->
        <record id="hostel_savoy_uk" model="hostel.hostel">
            <field name="name">The Savoy</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">SVY_LDN</field>
            <field name="street">Strand</field>
            <field name="phone">+442078364343</field>
            <field name="mobile">+442078364344</field>
            <field name="type">common</field>
        </record>

        <!-- 3. Le Bristol (France) -->
        <record id="hostel_bristol_fr" model="hostel.hostel">
            <field name="name">Le Bristol</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">BRS_PAR</field>
            <field name="street">112 Rue du Faubourg Saint-Honoré</field>
            <field name="phone">+33153434300</field>
            <field name="mobile">+33153434301</field>
            <field name="type">male</field>
        </record>

        <!-- 4. Fairmont Chateau Laurier (Canada) -->
        <record id="hostel_chateau_laurier_ca" model="hostel.hostel">
            <field name="name">Fairmont Chateau Laurier</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">FCL_OTT</field>
            <field name="street">1 Rideau St</field>
            <field name="phone">+16132411414</field>
            <field name="mobile">+16132411415</field>
            <field name="type">female</field>
        </record>

        <!-- 5. Ritz-Carlton Boston (USA) -->
        <record id="hostel_ritz_boston_us" model="hostel.hostel">
            <field name="name">Ritz-Carlton Boston</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">RTZ_BOS</field>
            <field name="street">15 Avery St</field>
            <field name="phone">+16175747000</field>
            <field name="mobile">+16175747001</field>
            <field name="type">common</field>
        </record>

        <!-- 6. Badrutt's Palace Hotel (Switzerland) -->
        <record id="hostel_badrutt_palace_ch" model="hostel.hostel">
            <field name="name">Badrutt's Palace Hotel</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">BPH_STM</field>
            <field name="street">Via Serlas 27</field>
            <field name="phone">+41818371000</field>
            <field name="mobile">+41818371001</field>
            <field name="type">common</field>
        </record>

        <!-- 7. Hotel Danieli (Italy) -->
        <record id="hostel_danieli_it" model="hostel.hostel">
            <field name="name">Hotel Danieli</field>
            <field name="category_id" ref="hostel_category_hotel"/>
            <field name="hostel_code">HDN_VEN</field>
            <field name="street">Riva degli Schiavoni 4196</field>
            <field name="phone">+390415260111</field>
            <field name="mobile">+390415260112</field>
            <field name="type">common</field>
        </record>

        <!-- 8. Generator Hostel London (UK) -->
        <record id="hostel_generator_london_uk" model="hostel.hostel">
            <field name="name">Generator Hostel London</field>
            <field name="category_id" ref="hostel_category_hostel"/>
            <field name="hostel_code">GEN_LDN</field>
            <field name="street">37 Tavistock Pl</field>
            <field name="phone">+442073887666</field>
            <field name="mobile">+442073887667</field>
            <field name="type">common</field>
        </record>

        <!-- 9. St Christopher's Inn Canal (France) -->
        <record id="hostel_st_christophers_paris_fr" model="hostel.hostel">
            <field name="name">St Christopher's Inn Canal</field>
            <field name="category_id" ref="hostel_category_hostel"/>
            <field name="hostel_code">SCI_PAR</field>
            <field name="street">159 Rue de Crimée</field>
            <field name="phone">+33140343440</field>
            <field name="mobile">+33140343441</field>
            <field name="type">common</field>
        </record>

        <!-- 10. Motel 6 Los Angeles (USA) -->
        <record id="hostel_motel6_la_us" model="hostel.hostel">
            <field name="name">Motel 6 Los Angeles</field>
            <field name="category_id" ref="hostel_category_motel"/>
            <field name="hostel_code">M6_LA</field>
            <field name="street">1015 W Olympic Blvd</field>
            <field name="phone">+12137461015</field>
            <field name="mobile">+12137461016</field>
            <field name="type">common</field>
        </record>

        <!-- Members -->
        <record id="member_hda" model="hostel.room.member">
            <field name="name">Husen Daudi</field>
        </record>
        <record id="member_jvo" model="hostel.room.member">
            <field name="name">Jay Vora</field>
        </record>
        <record id="member_vb" model="hostel.room.member">
            <field name="name">Vacha Bhatt</field>
        </record>
        <record id="member_jb" model="hostel.room.member">
            <field name="name">John Brunn</field>
        </record>
        <record id="member_alice" model="hostel.room.member">
            <field name="name">Alice Smith</field>
        </record>
        <record id="member_bob" model="hostel.room.member">
            <field name="name">Bob Jones</field>
        </record>
        <record id="member_charlie" model="hostel.room.member">
            <field name="name">Charlie Brown</field>
        </record>
        <record id="member_david" model="hostel.room.member">
            <field name="name">David Miller</field>
        </record>
        <record id="member_eva" model="hostel.room.member">
            <field name="name">Eva Green</field>
        </record>
        <record id="member_frank" model="hostel.room.member">
            <field name="name">Frank Harris</field>
        </record>

        <!-- Rooms -->
        <record id="hostel_room_102" model="hostel.room">
            <field name="name">Hostel Room 102</field>
            <field name="room_number">HR102</field>
            <field name="student_per_room">6</field>
            <field name="member_ids" eval="[(6, 0, [ref('member_hda'), ref('member_jvo'), ref('member_vb'), ref('member_jb'), ref('member_alice'), ref('member_bob')])]" />
        </record>
        <record id="hostel_room_103" model="hostel.room">
            <field name="name">Hostel Room 103</field>
            <field name="room_number">HR103</field>
            <field name="student_per_room">3</field>
            <field name="member_ids" eval="[(6, 0, [ref('member_alice'), ref('member_bob'), ref('member_charlie')])]" />
        </record>
        <record id="hostel_room_104" model="hostel.room">
            <field name="name">Hostel Room 104</field>
            <field name="room_number">HR104</field>
            <field name="student_per_room">3</field>
            <field name="member_ids" eval="[(6, 0, [ref('member_david'), ref('member_eva'), ref('member_frank')])]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- DEMO VÍ DỤ CÁC THAO TÁC X2MANY (0, 1, 2, 3, 4, 5, 6) VÀ COMMAND.* TRONG ODOO 20         -->
        <!-- ========================================================================================= -->

        <!-- 1. Chuẩn bị các member cho các ví dụ minh họa -->
        <record id="member_demo_target_1" model="hostel.room.member">
            <field name="name">Member Target 1 (for Tuple 4 Link)</field>
        </record>
        <record id="member_demo_target_2" model="hostel.room.member">
            <field name="name">Member Target 2 (for Command.link)</field>
        </record>

        <record id="member_demo_to_update_tuple" model="hostel.room.member">
            <field name="name">Original Name (for Tuple 1 Update)</field>
        </record>
        <record id="member_demo_to_update_cmd" model="hostel.room.member">
            <field name="name">Original Name (for Command.update)</field>
        </record>

        <record id="member_demo_to_delete_tuple" model="hostel.room.member">
            <field name="name">Member To Delete via Tuple 2</field>
        </record>
        <record id="member_demo_to_delete_cmd" model="hostel.room.member">
            <field name="name">Member To Delete via Command.delete</field>
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 0: TẠO MỚI BẢN GHI CON INLINE                                                   -->
        <!-- Ý nghĩa: Tạo mới một bản ghi con và gán liên kết trực tiếp vào field x2many.             -->
        <!-- Cảnh báo: Bản ghi tạo inline không có XML ID, mỗi lần nâng cấp module (-u) sẽ tạo bản    -->
        <!-- ghi mới trùng lặp. Vì vậy nên hạn chế dùng trong file data/demo XML tĩnh.                 -->
        <!-- ========================================================================================= -->
        <!-- 0A. Dùng cú pháp Tuple cổ điển: (0, False, vals) hoặc (0, 0, vals) -->
        <record id="hostel_room_demo_tuple_0" model="hostel.room">
            <field name="name">Demo Room - Tuple 0 (Create Inline)</field>
            <field name="room_number">R_TUPLE_0</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[(0, 0, {'name': 'Inline Member (Created via Tuple 0)'})]" />
        </record>

        <!-- 0B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.create(vals) -->
        <record id="hostel_room_demo_cmd_create" model="hostel.room">
            <field name="name">Demo Room - Command.create (Inline)</field>
            <field name="room_number">R_CMD_CREATE</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[Command.create({'name': 'Inline Member (Created via Command.create)'})]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 4: THÊM LIÊN KẾT VỚI BẢN GHI ĐÃ TỒN TẠI (LINK)                                  -->
        <!-- Ý nghĩa: Thêm liên kết tới record đã có mà KHÔNG xóa các liên kết đang có sẵn.           -->
        <!-- ========================================================================================= -->
        <!-- 4A. Dùng cú pháp Tuple cổ điển: (4, id, False) hoặc (4, id, 0) -->
        <record id="hostel_room_demo_tuple_4" model="hostel.room">
            <field name="name">Demo Room - Tuple 4 (Link)</field>
            <field name="room_number">R_TUPLE_4</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[(4, ref('member_demo_target_1'), False)]" />
        </record>

        <!-- 4B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.link(id) -->
        <record id="hostel_room_demo_cmd_link" model="hostel.room">
            <field name="name">Demo Room - Command.link</field>
            <field name="room_number">R_CMD_LINK</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[Command.link(ref('member_demo_target_2'))]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 6: THAY THẾ TOÀN BỘ DANH SÁCH BẰNG CÁC ID MỚI (SET / REPLACE ALL)              -->
        <!-- Ý nghĩa: Xóa toàn bộ liên kết cũ và gán bằng danh sách IDs mới được chỉ định.             -->
        <!-- Đây là lệnh phổ biến nhất khi khởi tạo quan hệ Many2many trong file XML data/demo.       -->
        <!-- ========================================================================================= -->
        <!-- 6A. Dùng cú pháp Tuple cổ điển: (6, False, [ids]) hoặc (6, 0, [ids]) -->
        <record id="hostel_room_demo_tuple_6" model="hostel.room">
            <field name="name">Demo Room - Tuple 6 (Set/Replace All)</field>
            <field name="room_number">R_TUPLE_6</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[(6, 0, [ref('member_alice'), ref('member_bob')])]" />
        </record>

        <!-- 6B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.set([ids]) -->
        <record id="hostel_room_demo_cmd_set" model="hostel.room">
            <field name="name">Demo Room - Command.set (Replace All)</field>
            <field name="room_number">R_CMD_SET</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[Command.set([ref('member_charlie'), ref('member_david')])]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 1: CẬP NHẬT GIÁ TRỊ CỦA BẢN GHI CON LIÊN KẾT (UPDATE)                           -->
        <!-- Ý nghĩa: Sửa các trường của bản ghi con liên kết có ID chỉ định.                          -->
        <!-- ========================================================================================= -->
        <!-- 1A. Dùng cú pháp Tuple cổ điển: (1, id, vals) -->
        <record id="hostel_room_demo_tuple_1" model="hostel.room">
            <field name="name">Demo Room - Tuple 1 (Update Child)</field>
            <field name="room_number">R_TUPLE_1</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[(1, ref('member_demo_to_update_tuple'), {'name': 'Updated via Tuple 1'})]" />
        </record>

        <!-- 1B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.update(id, vals) -->
        <record id="hostel_room_demo_cmd_update" model="hostel.room">
            <field name="name">Demo Room - Command.update (Child)</field>
            <field name="room_number">R_CMD_UPDATE</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[Command.update(ref('member_demo_to_update_cmd'), {'name': 'Updated via Command.update'})]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 3: NGẮT LIÊN KẾT KHỎI RECORD CHA (UNLINK / DETACH)                              -->
        <!-- Ý nghĩa: Gỡ bản ghi con ra khỏi field quan hệ nhưng KHÔNG xóa bản ghi con trong database. -->
        <!-- Minh họa: Bước 1 tạo phòng có 2 thành viên -> Bước 2 cập nhật gỡ 1 thành viên ra.         -->
        <!-- ========================================================================================= -->
        <!-- 3A. Dùng cú pháp Tuple cổ điển: (3, id, False) hoặc (3, id, 0) -->
        <record id="hostel_room_demo_tuple_3" model="hostel.room">
            <field name="name">Demo Room - Tuple 3 (Unlink)</field>
            <field name="room_number">R_TUPLE_3</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[(6, 0, [ref('member_alice'), ref('member_bob')])]" />
        </record>
        <record id="hostel_room_demo_tuple_3" model="hostel.room">
            <!-- Thao tác ngắt liên kết member_bob khỏi phòng R_TUPLE_3 (member_bob vẫn tồn tại trong DB) -->
            <field name="member_ids" eval="[(3, ref('member_bob'), False)]" />
        </record>

        <!-- 3B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.unlink(id) -->
        <record id="hostel_room_demo_cmd_unlink" model="hostel.room">
            <field name="name">Demo Room - Command.unlink</field>
            <field name="room_number">R_CMD_UNLINK</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[Command.set([ref('member_charlie'), ref('member_david')])]" />
        </record>
        <record id="hostel_room_demo_cmd_unlink" model="hostel.room">
            <!-- Thao tác ngắt liên kết member_david khỏi phòng R_CMD_UNLINK qua Command.unlink -->
            <field name="member_ids" eval="[Command.unlink(ref('member_david'))]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 5: XÓA SẠCH TOÀN BỘ LIÊN KẾT (CLEAR ALL LINKS)                                  -->
        <!-- Ý nghĩa: Làm rỗng danh sách liên kết mà KHÔNG xóa các bản ghi con trong database.         -->
        <!-- Minh họa: Bước 1 gán các thành viên -> Bước 2 cập nhật xóa trắng liên kết.                -->
        <!-- ========================================================================================= -->
        <!-- 5A. Dùng cú pháp Tuple cổ điển: (5, False, False) hoặc (5, 0, 0) -->
        <record id="hostel_room_demo_tuple_5" model="hostel.room">
            <field name="name">Demo Room - Tuple 5 (Clear All Links)</field>
            <field name="room_number">R_TUPLE_5</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[(6, 0, [ref('member_alice'), ref('member_bob')])]" />
        </record>
        <record id="hostel_room_demo_tuple_5" model="hostel.room">
            <!-- Thao tác xóa sạch tất cả thành viên khỏi phòng R_TUPLE_5 -->
            <field name="member_ids" eval="[(5, False, False)]" />
        </record>

        <!-- 5B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.clear() -->
        <record id="hostel_room_demo_cmd_clear" model="hostel.room">
            <field name="name">Demo Room - Command.clear (All Links)</field>
            <field name="room_number">R_CMD_CLEAR</field>
            <field name="student_per_room">2</field>
            <field name="member_ids" eval="[Command.set([ref('member_charlie'), ref('member_david')])]" />
        </record>
        <record id="hostel_room_demo_cmd_clear" model="hostel.room">
            <!-- Thao tác xóa sạch tất cả thành viên khỏi phòng R_CMD_CLEAR qua Command.clear -->
            <field name="member_ids" eval="[Command.clear()]" />
        </record>

        <!-- ========================================================================================= -->
        <!-- VÍ DỤ CẶP 2: XÓA VĨNH VIỄN BẢN GHI CON KHỎI DATABASE (DELETE PERMANENT)                   -->
        <!-- Ý nghĩa: Thực thi lệnh DELETE SQL xóa hoàn toàn bản ghi con khỏi database.                -->
        <!-- Thường áp dụng cho One2many lines (như các dòng chi tiết order line, room line).          -->
        <!-- ========================================================================================= -->
        <!-- 2A. Dùng cú pháp Tuple cổ điển: (2, id, False) hoặc (2, id, 0) -->
        <record id="hostel_room_demo_tuple_2" model="hostel.room">
            <field name="name">Demo Room - Tuple 2 (Delete Child Record)</field>
            <field name="room_number">R_TUPLE_2</field>
            <field name="student_per_room">2</field>
            <!-- Xóa vĩnh viễn record member_demo_to_delete_tuple khỏi database -->
            <field name="member_ids" eval="[(2, ref('member_demo_to_delete_tuple'), False)]" />
        </record>

        <!-- 2B. Dùng cú pháp Command hiện đại trong Odoo 20: Command.delete(id) -->
        <record id="hostel_room_demo_cmd_delete" model="hostel.room">
            <field name="name">Demo Room - Command.delete (Child Record)</field>
            <field name="room_number">R_CMD_DELETE</field>
            <field name="student_per_room">2</field>
            <!-- Xóa vĩnh viễn record member_demo_to_delete_cmd khỏi database qua Command.delete -->
            <field name="member_ids" eval="[Command.delete(ref('member_demo_to_delete_cmd'))]" />
        </record>
    </data>
</odoo>
