<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_category_book" model="ir.ui.view">
        <field name="name">Category Book Form</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <form string="Category Book">
                <header>
                    <button name="create_categories" string="Create Demo Categories" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Science Fiction"/>
                        </h1>
                    </div>
                    <group>
                        <group name="left_category">
                            <field name="parent_id"/>
                        </group>
                        <group name="right_category">
                            <field name="highlighted_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Detailed category description..."/>
                        </page>
                        <page string="Sub Categories" name="sub_categories">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Books" name="books">
                            <field name="books_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="author_ids" widget="many2many_tags"/>
                                    <field name="published_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_list_category_book" model="ir.ui.view">
        <field name="name">Category Book List</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="highlighted_id"/>
                <field name="child_ids" widget="many2many_tags" optional="show"/>
                <field name="books_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_search_category_book" model="ir.ui.view">
        <field name="name">Category Book Search</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <field name="parent_id"/>
                <filter name="parent_categories" string="Top Level Categories" domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Parent Category" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>