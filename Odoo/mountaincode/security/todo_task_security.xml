<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="privilege_todo" model='res.groups.privilege'>
            <field name="name">Todo Task privilege</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="category_player" />
        </record>
        <record id="group_todo_user" model="res.groups">
            <field name="name">Todo Task User Group</field>
            <field name="privilege_id" ref="privilege_todo" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>
        <record id="group_todo_manager" model="res.groups">
            <field name="name">Todo Task Manager Group</field>
            <field name="privilege_id" ref="privilege_todo" />
            <field name="implied_ids" eval="[(4, ref('group_todo_user'))]" />
        </record>
    </data>
</odoo>