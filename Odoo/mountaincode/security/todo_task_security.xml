<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_todo">
            <field name="name">Todo</field>
            <field name="description">Todo Category</field>
            <field name="sequence">150</field>
        </record>

        <record id="privilege_todo_management" model="res.groups.privilege">
            <field name="name">Todo Management</field>
            <field name="description">Access to Todo Management features</field>
            <field name="category_id" ref="module_category_todo"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_todo_user" model="res.groups">
            <field name="name">Todo Task User Group</field>
            <field name="privilege_id" ref="privilege_todo_management" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="group_todo_manager" model="res.groups">
            <field name="name">Todo Task Manager Group</field>
            <field name="privilege_id" ref="privilege_todo_management" />
            <field name="implied_ids" eval="[(4, ref('group_todo_user'))]" />
        </record>

        <!-- rule permission -->
        <record id="player_rule" model="ir.rule">
            <field name="name">Player Rules</field>
            <field name="model_id" ref="model_player" />
            <field name="domain_force">[('transfer','>=', 0)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="cat_rule" model="ir.rule">
            <field name="name">Cat Rules</field>
            <field name="model_id" ref="model_cat" />
            <field name="domain_force">[('age','>=',0 )]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="dog_rule" model="ir.rule">
            <field name="name">Dog Rules</field>
            <field name="model_id" ref="model_dog" />
            <field name="domain_force">[('age','>=',0)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>