@using DISample.Services
@using DISample.Models
@using Microsoft.Extensions.Configuration
@model List<DISample.Service.DTOs.TodoItem>
@inject IConfiguration Configuration
@inject IStatisticsService StatsService
@* @model IEnumerable<ToDoItem> *@

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h5>
        Configuration injection => MyRoot:MyParent:MyChildName: @Configuration["MyRoot:MyParent:MyChildName"]
    </h5>
    <div>
        <h1>To Do Items</h1>
        <ul>
            <li>Total Items: @StatsService.GetCount()</li>
            <li>Completed: @StatsService.GetCompletedCount()</li>
            <li>Avg. Priority: @StatsService.GetAveragePriority()</li>
        </ul>
        <table>
            <tr>
                <th>Name</th>
                <th>Priority</th>
                <th>Is Done?</th>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Priority</td>
                    <td>@item.IsDone</td>
                </tr>
            }
        </table>
    </div>
    @foreach (var item in Model)
    {
        <p>
            @item.Id - @item.Name
        </p>
    }
    
    <h4>Transient</h4>
        @ViewBag.TransientService1 <br />
        @ViewBag.TransientService2
    
    <h4>Scoped</h4>
        @ViewBag.ScopedService1 <br />
        @ViewBag.ScopedService2
    
    <h4>Singleton</h4>
        @ViewBag.SingletonService1 <br />
        @ViewBag.SingletonService2
    
</div>
